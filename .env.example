# Template for the gitignored .env files. NEVER put real values in this file.
# Recovery guide (what each key is, where to re-issue it): docs/ENV-RECOVERY.md
#
# Split across three local files:
#   .env.local       — site + Supabase + shared API keys
#   .env.engagement  — Instagram engagement agents
#   .env.instagram   — Meta Graph API
# Anything the deployed site or a Vercel cron needs must ALSO be set in the
# Vercel project env vars — local agents and deployed crons read different copies.

# ─── .env.local ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=your-database-url

# Cron + admin endpoint authentication.
# Self-chosen secret — nothing can re-issue it. Also hardcoded in three
# scheduled-task prompts; rotating it means updating those too (see recovery doc).
CRON_SECRET=your-cron-secret

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Paw Cities <noreply@pawcities.com>
ADMIN_EMAILS=admin@pawcities.com

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_MONTHLY_PRICE_ID=your-monthly-price-id
STRIPE_ANNUAL_PRICE_ID=your-annual-price-id

# Google Places (photo proxy and enrichment)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# AI providers. OPENAI_API_KEY powers comment generation and the GPT-4o Vision
# poster/flyer extraction in the handle-discovery and process-ingest crons.
OPENAI_API_KEY=your-openai-api-key
OPENAI_COMMENT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
ANTHROPIC_API_KEY=your-anthropic-api-key

# Apify (scraping actors)
APIFY_TOKEN=your-apify-token

# Public site URLs
NEXT_PUBLIC_BASE_URL=https://pawcities.com
NEXT_PUBLIC_SITE_URL=https://pawcities.com
NEXT_PUBLIC_APP_URL=https://pawcities.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=your-ga-measurement-id

# ─── .env.engagement ──────────────────────────────────────────────────────────
# The real @thepawcities Instagram login. Highest-value secret in the project —
# losing or leaking it is account takeover, not an outage. Keep a copy in your
# password manager; a reset triggers Instagram security review on an account
# that has already been flagged once.
IG_USERNAME=your-instagram-username
IG_PASSWORD=your-instagram-password
IG_SESSION_PATH=./data/engagement/.ig-session
IG_PROXY=

# ─── .env.instagram ───────────────────────────────────────────────────────────
# Rotating META_APP_SECRET invalidates META_PAGE_ACCESS_TOKEN — regenerate both.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
FACEBOOK_PAGE_ID=your-facebook-page-id
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id
INSTAGRAM_USERNAME=thepawcities
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
META_API_VERSION=v25.0
